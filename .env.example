# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# The free tier covers text conversion plus fallback speech in/out.
GEMINI_API_KEY=

# Optional speed upgrades (both have generous free tiers, no card needed).
# ElevenLabs (https://elevenlabs.io -> Profile -> API Keys): fast speech output.
ELEVENLABS_API_KEY=
# Deepgram (https://console.deepgram.com): fast transcription.
DEEPGRAM_API_KEY=

# Optional overrides
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Charon
# ELEVENLABS_MODEL=eleven_flash_v2_5
